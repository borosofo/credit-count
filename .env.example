# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.
# Only the publishable (anon) key is ever used by this app. It is designed to be
# public; Row Level Security is what protects the data. The service-role key is
# not used anywhere and must never be added here or to Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only for `npm run rls-check`: a mailbox you control. The script signs up
# throwaway users as plus-aliases of it (Supabase rejects example.com addresses).
RLS_CHECK_EMAIL=you@example.org
